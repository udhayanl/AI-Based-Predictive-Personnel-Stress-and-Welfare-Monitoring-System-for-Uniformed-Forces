# Render / Local Backend Environment Variables

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Optional: Remote URL to download personnel_stress_model.pkl if not committed via Git LFS
# (e.g. from Supabase Storage bucket, GitHub Releases, or Hugging Face)
MODEL_DOWNLOAD_URL=

# Port is automatically assigned by Render (default 8000 for local)
PORT=8000
